# Environment Variables Template
# Copy this file to .env.local and fill in the actual values
# DO NOT commit .env.local to git - it should be in .gitignore

#Important  
#Set public environment variables in public/env.js for client-side access

#Environment
APP_ENV=local

# Logging configuration
# Set to 'true' to enable debug/info logs (local development, debugging)
# Set to 'false' or omit for production (only errors and warnings)
NEXT_PUBLIC_ENABLE_LOGGING=true

NEXT_PUBLIC_APP_VERSION=dev

# Backend API configuration (client-side accessible)
NEXT_PUBLIC_API_BASE=http://localhost:8001/api

# Server-side backend URL (for Docker containers)
NEXT_SERVER_BE_URL=http://host.docker.internal:8001/api

# Development only - remove for production
NEXT_PUBLIC_BE_TOKEN=your-dev-token-here
NEXT_PUBLIC_COMMANDER=True
NEXT_PUBLIC_SIGNATURE=IR#4080

# App URL configuration
NEXT_PUBLIC_APP_URL=http://localhost:4000

# Azure Entra (Web app / confidential client)
ENTRA_TENANT_ID=your-actual-tenant-id-here
ENTRA_CLIENT_ID=your-web-app-client-id-here
ENTRA_CLIENT_SECRET=your-actual-client-secret-here

# Authority & redirect URI
MSAL_AUTHORITY=https://login.microsoftonline.com/your-actual-tenant-id-here
MSAL_REDIRECT_URI=http://localhost:4000/api/auth/callback

# Microsoft Entra API scope configuration
ENTRA_API_SCOPES=api://your-client-id-here/agentverse_access

# Session secret for JWT signing (MUST be a secure random string in production)
# Generate with: openssl rand -base64 32
SESSION_SECRET=your-super-secret-key-for-signing-jwt-tokens-change-this-in-production

# Optional local Genesis (requires matching local API configuration and signing secret)
AUTH_MODE=entra
# LOCAL_JWT_SECRET=<same private secret as API; at least 32 characters>
GENESIS_LOGOUT_REQUIRED=false
GENESIS_LOCAL_SESSION_URL=http://127.0.0.1:8001/api/v2/agentverse/session/local
GENESIS_LOGOUT_URL=http://127.0.0.1:8001/api/v2/agentverse/session/logout
# Host Redis consumer URL; use the coordinated private password, never commit it.
# REDIS_URL=redis://:PASSWORD@127.0.0.1:6380/0

# Optional V2 conversation workspace (server-only; current V2 API required)
# GENESIS_COMMUNICATION_URL=http://127.0.0.1:8001/api/v2/agentverse/communication
# Optional authoritative Enki draft review and human approval (server-only)
# GENESIS_AGENTS_URL=http://127.0.0.1:8001/api/v2/agentverse/agents
# Override only when the browser needs a different reachable origin:
# GENESIS_WEBSOCKET_URL=ws://127.0.0.1:8001
