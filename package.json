    "next-themes": "^0.2.1",
    "pdfjs-dist": "^4.10.38",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.48.2",
    "react-markdown": "^10.1.0",
    "react-redux": "^9.2.0",
