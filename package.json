    "shadcn": "^4.22.1",
    "tailwindcss": "^3.3.0",
    "typescript": "^5",
    "typescript-eslint": "^8.44.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.11"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,md}": [
      "prettier --write"
    ]
